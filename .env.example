# Copy to .env and fill in what you use. Nothing here is required for offline / rule-only mode.

# --- LLM providers (pick one in config/settings.yaml or via FA_LLM_PROVIDER) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Any OpenAI-compatible server (vLLM, LM Studio, OpenRouter...). Leave empty for api.openai.com
OPENAI_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434

# Override provider/model without editing YAML
# FA_LLM_PROVIDER=anthropic   # anthropic | openai | ollama | none
# FA_LLM_MODEL=
# Per-provider default models (optional)
ANTHROPIC_MODEL=
OPENAI_MODEL=
OLLAMA_MODEL=qwen3:8b

# --- Product ---
# research (default): no buy/sell advice or price levels. advisor: licensed investment-consulting firms only.
FA_MODE=research
# Show the advisor-mode switch in the web app (only on deployments run by a licensed firm)
FA_ALLOW_ADVISOR=0
# Web app access: apikey = sign in with a tenant API key (any shared deployment); none = local development only
FA_UI_AUTH=none
# Operator tools in the web app (model lab, LLM choice, champion promotion). Defaults to 1 only when FA_UI_AUTH=none
# FA_UI_ADMIN=0
# Secret for the audit log's HMAC hash chain. Set a long random value in production and keep it out of the repo
# (python -c "import secrets; print(secrets.token_hex(32))"). Without it a per-install key file runs/.audit_key is used.
FA_AUDIT_KEY=
# LightGBM threads for batch jobs that don't load torch (rolling backtests, ranking)
# FA_LGBM_JOBS=4

# --- Data ---
# FinMind token (free signup at finmindtrade.com) raises TW data rate limits
FINMIND_TOKEN=

# Hugging Face cache location (models are ~0.5-1.5 GB each)
# HF_HOME=~/.cache/huggingface
